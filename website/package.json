{
  "name": "astra-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "probe": "esbuild scripts/pred_probe.ts --bundle --platform=node --outfile=scripts/_pred_probe.cjs --log-level=error && node scripts/_pred_probe.cjs",
    "audit:metrics": "esbuild scripts/metric_audit.ts --bundle --platform=node --outfile=scripts/_metric_audit.cjs --log-level=error && node scripts/_metric_audit.cjs",
    "docs:check": "esbuild scripts/docs_check.ts --bundle --platform=node --outfile=scripts/_docs_check.cjs --log-level=error && node scripts/_docs_check.cjs",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --outfile=scripts/_page_smoke.cjs --log-level=error && node scripts/_page_smoke.cjs",
    "verify:dist": "esbuild scripts/verify_dist.ts --bundle --platform=node --outfile=scripts/_verify_dist.cjs --log-level=error && node scripts/_verify_dist.cjs",
    "check": "npm run docs:check && npm run smoke && npm run build && npm run verify:dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
